{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crpp.dev/schema/0.1/common.schema.json",
  "title": "CRPP common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/identifier" },
        "actor_type": {
          "enum": ["person", "organization", "third_party_controller", "escrow_operator", "service"]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_id", "method", "value"],
      "properties": {
        "signer_id": { "$ref": "#/$defs/identifier" },
        "method": { "type": "string", "minLength": 3, "maxLength": 100 },
        "value": { "type": "string", "minLength": 3, "maxLength": 4096 }
      }
    },
    "operation": {
      "enum": ["read", "copy", "project", "invoke", "train", "publish", "commercialize", "delegate"]
    },
    "authority_domain": {
      "enum": ["personal", "company", "joint", "third_party"]
    },
    "provenance_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_object_id", "to_object_id", "relationship", "contributor_ids"],
      "properties": {
        "from_object_id": { "$ref": "#/$defs/identifier" },
        "to_object_id": { "$ref": "#/$defs/identifier" },
        "relationship": { "enum": ["contributed_to", "derived_from", "references", "contains"] },
        "contributor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
