{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crpp.dev/schema/0.1/access-grant.schema.json",
  "title": "CRPP Access Grant",
  "x-crpp-rule-ids": ["CRPP-GRANT-001", "CRPP-GRANT-002", "CRPP-GRANT-003", "CRPP-GRANT-004"],
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "protocol_version", "grantor_ids", "grantee_id", "scope", "operation", "purpose", "starts_at", "expires_at", "copy_allowed", "training_allowed", "delegation_allowed", "signatures"],
  "properties": {
    "grant_id": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/identifier" },
    "protocol_version": { "const": "0.1.0-draft.1" },
    "grantor_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/identifier" } },
    "grantee_id": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/identifier" },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/identifier" } },
    "operation": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/operation" },
    "purpose": { "type": "string", "minLength": 3, "maxLength": 200 },
    "starts_at": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/timestamp" },
    "remaining_uses": { "type": "integer", "minimum": 0 },
    "output_schema_id": { "type": "string", "format": "uri-reference" },
    "copy_allowed": { "type": "boolean" },
    "training_allowed": { "type": "boolean" },
    "delegation_allowed": { "type": "boolean" },
    "commercialization_allowed": { "type": "boolean", "default": false },
    "revocation_conditions": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "https://crpp.dev/schema/0.1/common.schema.json#/$defs/signature" } },
    "extensions": { "type": "object" }
  }
}
