{
  "name": "@crpp/conformance",
  "version": "0.1.0-draft.1",
  "description": "Open protocol for separating company facts, portable capability, joint context, and third-party rights",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test conformance/runner/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage conformance/runner/*.test.mjs",
    "validate": "node conformance/runner/cli.mjs",
    "lint": "node scripts/lint.mjs",
    "demo": "node reference/cli.mjs demo/employee-exit/input.json"
  },
  "bin": {
    "crpp": "reference/cli.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "license": "Apache-2.0"
}
